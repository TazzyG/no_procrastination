                  <%= form.label :body %>
                </div>            
                  <%= form.submit "Submit", class: "btn btn-primary w-100 py-w.5 rounded-3 fw-semibold mb-3", type: "submit" %> 
                </form>
            </div>
          </div>
        </div>
      
<% end %>

      