<!DOCTYPE html>
<html>
  <head>
  
   <title>Stopping my procrastination </title>
    
    <meta property="og:title" content="Friendly Road">
  
    <!-- Basic Open Graph Tags -->
    <%= tag.meta property: "og:type", content: "website" %>
    <%= tag.meta property: "og:title", content: "Friendlyroad" %>
    <%= tag.meta property: "og:description", content: "Track what matters" %>

    <!-- Absolute URL to the Image -->
    <meta name="description" content="track what matters" >
    <meta property="og:image" content= <%= image_url("fr-thumb.png")%> />
    <meta property="og:type" content="website" /> 
    <meta property="og:url" content="https://friendlyroad.com" />
    <meta property="og:title" content="Track what matters" /> 
    <meta property="og:description" content="a private space for tracking my goals and end the procrastination between goals and actions" />
    <%= tag.meta property: "og:image:width", content: "1200" %>
    <%= tag.meta property: "og:image:height", content: "630" %>

    <meta charset="UTF-8" />
    <html lang="en">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://cloudflare.com" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    


    <meta name="viewport" content="width=device-width,initial-scale=1">
   
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts Preconnect (Optimized - No Duplicates) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <%= yield :head %>
  
    <%# This links your application.scss styles compiled by Dart Sass %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    
    <%# This brings in your Bootstrap-enabled Importmap JavaScript %>
    <%= javascript_importmap_tags %>

    <!-- Font Awesome 6 Free Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />


    <%= favicon_link_tag 'favicon.ico' %>
  </head>

  <body data-bs-theme="dark">
   <%= yield %>
    <%= render 'layouts/flash_messages' %>
  </body>
</html>