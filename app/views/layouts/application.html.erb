<!DOCTYPE html>
<html lang="en">
  <head>
  
   <title>Track What Matters</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta property="og:title" content="Track What Matters">
    <meta property="og:description" content="A private place for keeping track of my progress and collecting records of my journey">
    <meta property="og:url" content="https://friendlyroad.com">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Friendlyroad.com">
    <meta property="og:image" content="https://friendlyroad.com/og-preview.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="Starting a journey with ideas and thoughts">
    <meta property="twitter:card" content="summary_large_image">
    <meta charset="UTF-8" />
  
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  

    <link rel="stylesheet" href="https://cloudflare.com" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    


    <meta name="viewport" content="width=device-width,initial-scale=1" />
   
  

    <!-- Google Fonts Preconnect (Optimized - No Duplicates) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet" />
    
  
  
    <%# This links your application.scss styles compiled by Dart Sass %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    
    <%# This brings in your Bootstrap-enabled Importmap JavaScript %>
    <%= javascript_importmap_tags %>

    <!-- Font Awesome 6 Free Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />


    <%= favicon_link_tag 'favicon.ico' %>


  </head>

  <body data-bs-theme="dark">
   <%= yield %>
    <%= render 'layouts/flash_messages' %>
  </body>
</html>