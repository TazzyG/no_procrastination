<!DOCTYPE html>
<html lang="en">
  <head>
  
    <title>Track What Matters</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://friendlyroad.com">
    <meta property="og:title" content="Track What Matters">
    <meta property="og:description" content="A private place for keeping track of my progress and collecting records of my journey">
    <meta property="og:site_name" content="Friendlyroad.com">
    <meta property="og:image" content="<%= asset_url('og-preview.png') %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="Starting a journey with ideas and thoughts">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">

    <!-- Icons -->
    <%= favicon_link_tag 'favicon.ico' %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet" />

    <!-- Rails Assets compilation -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>


  </head>

  <body data-bs-theme="dark">
   <%= yield %>
    <%= render 'layouts/flash_messages' %>
  </body>
</html>