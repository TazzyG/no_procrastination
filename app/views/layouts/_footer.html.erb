<footer class="footer bg-dark text-white">
	<div class="container-custom d-flex justify-content-between align-items-center py-3 border-highlight">
		<div class="col-nd-4 d-flex align-items-center">
			<%= link_to root_path, class: "text-muted text-decoration-none" do %>
				<i class="fa-solid fa-mug-hot"></i>
				<span class="text-muted small">© <%= Date.today.year %> Another FriendlyRoad Project</span>		 
			<% end %>
		</div>
		<div class="col-nd-4 d-flex align-items-center">
		<% if authenticated? %>
				<span class="text-muted small">Logged in as: <%= Current.session.user.email_address %></span>
			<% else %>
			<%= link_to new_session_path, class: "text-muted text-decoration-none" do %>
				<i class="fa-solid fa-user" aria-hidden="true"></i>
				<span class="text-muted small"> Admin Log In </span>
			<% end %>
		<% end %>
		</div> 


		<div class="col-nd-4 d-flex align-items-right">
		 	<% if authenticated? %>
						<%= button_to "Log Out", session_path, 
                  method: :delete, 
                  class: "btn btn-sm btn-outline-danger" %>
					<% end %>
			</div>
	</div>
</footer>
    