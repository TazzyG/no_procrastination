<h2 class="fw-bold mb-4 hero__heading">Recent Posts <%= @posts.count %></h2>
<div id="carouselPosts" class="carousel slide" data-bs-autoplay="true" data-controller="carousel">
  <div class="carousel-inner">
    <div class="carousel-item active">
      <p class="text-white-50 fst-italic lh-base mt-4">
        Behind the scenes, I am working on my own methods while building this website as one of my own goals. <br>
        I wish you all many happy trails.
      </p>
    </div>

    <% @posts.each do |post| %>
      <div class="carousel-item">
        <p class="text-white-50 fst-italic lh-base mt-4">
          <%= post.title %>
          <%= post.body %>
        </p>
      </div>
    <% end %> 

  </div>
</div>

