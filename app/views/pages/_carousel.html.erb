<% if @posts.present? %>
  <div id="carouselPosts" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000", data-bs-target="#carouselPosts">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <p class="text-white-50 fst-italic lh-base mt-4">
          Behind the scenes, I am working on my own methods while building this website as one of my own goals. <br>
          I wish you all many happy trails.
        </p>
      </div>

      <% @posts.each do |post| %>
        <div class="carousel-item">
          <p class="text-white-50 fst-italic lh-base mt-4">
            <%= post.title %>
            <%= post.body %>
          </p>
        </div>
      <% end %> <%# Moved this up so it only closes the loop %>

    </div> <%# .carousel-inner closes outside the loop %>
  </div> <%# #carouselPosts closes outside the loop %>
<% else %>
  <p class="text-white-50 fst-italic lh-base mt-4">
    Behind the scenes, I am working on my own methods while building this website as one of my own goals. <br>
    I wish you all many happy trails.
  </p> <%# Added the missing closing tag here %>
<% end %>

