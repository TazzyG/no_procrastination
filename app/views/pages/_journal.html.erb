<header class="hero">
	<div class="hero__overlay"> </div>
	<%= video_tag "journal/journalling.mp4", controls:false,  playsinline:"playsinline", autoplay:"autoplay", muted:"muted", Loop:"loop",  class:"hero__video"%>
	<%= video_tag "journal/journalling.mov", controls:false,  playsinline:"playsinline", autoplay:"autoplay", muted:"muted", Loop:"loop", class:"hero__video"%>
	<%= video_tag "journal/journal.png",  class:"hero__video"%>
	<div class="hero__content h-100 container-custom position-relative">
		<div class="d-flex h-100 align-items-center hero__content-width">
			<div class="text-white">
				<h1 class="fw-bold mb-4 hero__heading">Track What Matters</h1>
				<p class="lead mb-4"> This is a personal place to track progress, set intentions, and track what matters. There are no registrations, no logins, and no distractions. Just a private space to reflect, plan, and build momentum.
			  </p>	
        
			<hr class="light">
        <div id="carouselPosts class="carousel slide"  data-bs-autoplay="true">
				
          <div class="carousel-inner">
						<div class="carousel-item active">
							<p class= "text-white-50 fst-italic lh-base mt-4 item active"> Behind the scenes, I am working on my own methods while building this website as one of my own goals. <br> I wish you all many happy trails. 
							</p>
						</div>
						<div class="carousel-item">
							<p class= "text-white-50 fst-italic lh-base mt-4 item"> Start with a problem you want to solve </p>
						</div>
						<div class="carousel-item">
              <p class= "text-white-50 fst-italic lh-base mt-4 item"> Interesting problems generate friends </p>
						</div>
						<div class="carousel-item">
              <p class= "text-white-50 fst-italic lh-base mt-4 item"> Find a friend Work on something together </p>
						</div>
						<div class="carousel-item">
              <p class= "text-white-50 fst-italic lh-base mt-4 item"> Discover the passion that drives you</p>
						</div>
						<div class="carousel-item">	
              <p class= "text-white-50 fst-italic lh-base mt-4 item">Test, learn, grow to find real value</p>
						</div>
						<div class="carousel-item">
              <p class= "text-white-50 fst-italic lh-base mt-4 item"> Do something!</p>
						</div>
						<div class="carousel-item">
              <p class= "text-white-50 fst-italic lh-base mt-4 item"> Share ideas with friends</p>
						</div>
           
          </div>
        </div>
       
        <p> <%= image_tag "logo-color.png", class: "img-fluid mb-4 mx-auto logo-subtle" , alt: "Friendlyroad logo" %>
        </p>  

				<p>
				 	<% if authenticated? %>
						<div class="alert alert-success">Logged in as: <%= Current.session.user.email_address %></div>
						<%= button_to "Log Out", session_path, 
                  method: :delete, 
                  class: "btn btn-sm btn-outline-danger" %>
					<% end %>
					 		
  					</div>
				</p>

			</div>
		</div>
	</div>
</header>


